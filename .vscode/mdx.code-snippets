{
	"Terminal Customizado MDX": {
		"prefix": "/terminal",
		"body": [
			"<Terminal>",
			"  <Abas>",
			"    <Aba active>VM1</Aba>",
			"    <Aba>VM2</Aba>",
			"    <Aba>VM3</Aba>",
			"  </Abas>",
			"  <Code>",
			"    <Comentario>Comentário</Comentario>",
			"    <Linha texto=\"\">Comando</Linha>",
			"  </Code>",
			"</Terminal>"
			],
			"description": "Insere um bloco de terminal limpo e customizado no MDX."
	},

	"Comentário dentro do MDX_Terminal": {
		"prefix": "/comentario_terminal",
		"body": [
			"<Comentario>$1</Comentario>"
		],
		"description": "Insere um comentádio, específico para a estrutura do Terminal_MDX"
	},

	"Comando dentro do MDX_Terminal": {
		"prefix": "/linha_terminal",
		"body": [
			"<Linha texto=\"\">${1:Comando}</Linha>"
		],
		"description": "Insere um Comando, específico para a estrutura do Terminal_MDX"
	},

	"Resultado de um comando do MDX_Terminal": {
		"prefix": "/resultado_terminal",
		"body": [
			"<Resultado>Resultado</Resultado>"
		],
		"description": "Insere o componente Resultado na estrutura do Terminal_MDX"
	},

	"Tabela": {
		"prefix": "/tabela",
		"body": [
			"| Item | Valor |",
			"| ---- | ----- |",
			"| item1 | valor1 |"
		],
		"description": "Insere a estrutura inicial de uma tabela para arquivos MDX."
	},

	"Linha para Tabela": {
		"prefix": "/tabela_linha",
		"body": [
			"| itemX | valorX |"
		],
		"description": "Insere uma linha na estrutura de uma tabela já existente."
	},

	"Questão para Lista de Programação": {
		"prefix": "/questao",
		"body": [
			"<Questao",
			"  id=\"${2:id}\"",
			"  linksResolucao={",
			"    <>",
			"      <QuestaoLink slug=\"${3:arquivo resposta}\" linguagem=\"${4:linguagem abreviada}\" />",
			"    </>",
			"  }",
			">",
			" ${1:Enunciado}",
			"</Questao>",
		],
		"description": "Insere a estrutura para uma questão de uma lista."
	},

	"Link para Resposta de Questão": {
		"prefix": "/link_questao",
		"body": [
			"<QuestaoLink slug=\"${1:arquivo resposta}\" linguagem=\"${2:linguagem abreviada}\" />"
		],
		"description": "Insere o link para a resposta de uma questão de uma lista."
	}
}