{
  // Configurações Específicas para JSON
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },

  // Configurações GLOBAIS
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.tabSize": 4,
  "editor.guides.highlightActiveIndentation": true,
  "editor.detectIndentation": false,

    // Configurações para Linhas Verticais e Horizontais para cada Bloco de Código
    "editor.bracketPairColorization.enabled": true,
    "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
    "editor.guides.bracketPairs": true,
    "editor.guides.bracketPairsHorizontal": true,
    "editor.guides.highlightActiveBracketPair": true,
    "editor.guides.indentation": true,

    // Customização de Cores (Transparência Segura de Fallback)
    "workbench.colorCustomizations": {
      "editorBracketPairGuide.activeBackground1": "#a1a1a135",
      "editorBracketPairGuide.activeBackground2": "#a1a1a135",
      "editorBracketPairGuide.activeBackground3": "#a1a1a135",
      "editorBracketPairGuide.activeBackground4": "#a1a1a135",
      "editorBracketPairGuide.activeBackground5": "#a1a1a135",
      "editorBracketPairGuide.activeBackground6": "#a1a1a135",

      "editorBracketPairGuide.background1": "#3b82f6ff",
      "editorBracketPairGuide.background2": "#10b981ff",
      "editorBracketPairGuide.background3": "#f59e0bff",
      "editorBracketPairGuide.background4": "#ef4444ff",
      "editorBracketPairGuide.background5": "#8b5cf6ff",
      "editorBracketPairGuide.background6": "#ec4899ff",
    },

  "editor.quickSuggestions": {
    "other": "on"
  },

  // Configurações de Equivalência de Linguagens
  "emmet.includeLanguages": {
    "mdx": "typescriptreact"
  },

  "files.associations": {
    "*.mdx": "markdown"
  },

  // Configurações Específicas para MARKDOWN
  "[markdown]": {
    "editor.quickSuggestions": {
      "other": "on",
      "comments": "off",
      "strings": "off"
    },
    "editor.snippetSuggestions": "top" // Joga os seus snippets para o topo da lista de sugestões
  },

  
  // Configurações Específicas para TYPESCRIPT - REACT
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },

  // Configurações Específicas para JAVASCRIPT - REACT
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },

  // Configurações Específicas para MDX
  "[mdx]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  }
}